# ---------------------------------------------------------------------------
# DSA Forge - environment
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Never commit real credentials. Only NEXT_PUBLIC_* values reach the browser;
# everything else stays on the server.
#
# DATABASE_URL is required everywhere. For a deployment, see DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Database: PostgreSQL (server only) -------------------------------------
# Required. The app stores everything here and has no local-file fallback.
#
# Neon (https://neon.tech) -> your project -> Connection string. Use the POOLED
# host (the one containing "-pooler"): a serverless deployment opens a
# connection per instance, and the pooler is what stops that exhausting the
# connection limit.
#
# Create the schema with `npm run db:deploy`, then load the catalogue with
# `npm run db:seed`. See DEPLOYMENT.md.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentication: Clerk --------------------------------------------------
# Clerk owns sign-in and sign-up. Get both keys from
# https://dashboard.clerk.com -> your app -> API keys.
#
# Without them the app falls back to its built-in email/password form, so a
# fresh checkout still works. With them, Clerk takes over and the local form
# disappears. The publishable key is safe in the browser; the secret key must
# never reach client code.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# --- Sessions ---------------------------------------------------------------
# Signs session cookies. Development derives a per-machine value automatically;
# production REQUIRES this and throws without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable — changing it signs every existing user out.
# SESSION_SECRET=""

# --- AI provider (optional) ------------------------------------------------
# Everything AI-powered degrades gracefully when this is absent: the built-in
# adaptive engine still produces recommendations and learning paths from your
# real performance data, and curated hints are served instead of generated ones.
#
# AI_PROVIDER: "anthropic" | "openai" | any OpenAI-compatible gateway name
#   (for a gateway, also set AI_BASE_URL).
AI_PROVIDER="anthropic"
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"
# AI_BASE_URL="https://api.openai.com/v1"
AI_MAX_TOKENS="2048"

# --- Code execution --------------------------------------------------------
# "local"  - dev only. Runs code on this host with a stripped environment, a
#            hard timeout, an stdout cap and (on POSIX) CPU/memory/process
#            rlimits. NOT a security boundary; refuses to start in production.
# "remote" - the sandboxed Docker worker in ./sandbox. Use this in production.
EXECUTION_DRIVER="local"
# EXECUTION_SERVICE_URL="http://sandbox-host:8080"
# EXECUTION_SERVICE_TOKEN=""

EXECUTION_TIMEOUT_MS="5000"
EXECUTION_MEMORY_MB="256"
EXECUTION_OUTPUT_LIMIT_BYTES="65536"
EXECUTION_CONCURRENCY="4"
EXECUTION_MAX_PENDING="120"
# EXECUTION_WORKDIR="/var/tmp/forge"

# --- Platform --------------------------------------------------------------
# Comma-separated emails that are granted the platform ADMIN role on first
# sign-in. Faculty rights are granted separately: npm run make:faculty
ADMIN_EMAILS=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

// DSA Forge — Prisma schema
//
// Storage is a local SQLite file (prisma/dsaforge.db) so the app runs with no
// database server and no hosted account. Two SQLite constraints shape this
// file: scalar lists are unsupported (those columns are Json, read through the
// helpers in src/lib/json-fields.ts), and there is no TEXT native type
// (String is already unbounded).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
}

enum DsaLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CareerGoal {
  LEARN_DSA
  UNIVERSITY_PREP
  PLACEMENT_PREP
  PRODUCT_COMPANY
  SERVICE_COMPANY
  COMPETITIVE_PROGRAMMING
  INTERVIEW_PREP
}

enum PlatformRole {
  STUDENT
  FACULTY
  ADMIN
}

enum UniversityRole {
  STUDENT
  FACULTY
  HOD
  ADMIN
}

enum TestCaseKind {
  SAMPLE
  HIDDEN
  EDGE
  STRESS
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  OUTPUT_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum ExecutionMode {
  RUN
  SUBMIT
  UNIVERSITY
  VALIDATION
}

enum ExecutionStatus {
  QUEUED
  COMPILING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AttemptOutcome {
  NOT_ATTEMPTED
  ATTEMPTED
  SOLVED
}

enum CompanyCategory {
  PRODUCT
  SERVICE
  STARTUP
  FINTECH
  CONSULTING
  CORE
  OTHER
}

enum QuestionSource {
  CURATED
  AI_GENERATED
  FACULTY
  IMPORTED
}

/// Provenance label shown next to company-tagged questions. We never claim a
/// problem was literally asked at a company unless it is verified.
enum SourceConfidence {
  VERIFIED_HISTORICAL
  COMPANY_STYLE
  AI_PATTERN
}

enum AIQuestionStatus {
  DRAFT
  VALIDATING
  VALIDATION_FAILED
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum RecommendationKind {
  NEXT_PROBLEM
  TOPIC_FOCUS
  DIFFICULTY_SHIFT
  REVISION
  COMPANY_PREP
  LEARNING_PATH_STEP
}

enum UniversityTestStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum TestAttemptStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  ABSENT
}

enum SimilarityVerdict {
  LOW
  MODERATE
  REVIEW_RECOMMENDED
}

enum NotificationKind {
  TEST_SCHEDULED
  TEST_STARTING
  RESULT_PUBLISHED
  AI_RECOMMENDATION
  ACHIEVEMENT_UNLOCKED
  STREAK_REMINDER
  SYSTEM
}

enum AchievementCategory {
  MILESTONE
  STREAK
  DIFFICULTY
  TOPIC
  INTERVIEW
  UNIVERSITY
}

// ---------------------------------------------------------------------------
// Identity & profile
// ---------------------------------------------------------------------------

/// Login credentials. Kept separate from the profile so a password change or a
/// session sweep never touches learning data.
model UserAccount {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Clerk owns authentication; this is the local mirror of a Clerk user, and
  /// the join between a Clerk identity and everything the product stores.
  /// Null on accounts created before Clerk, which can still sign in by password.
  clerkUserId  String? @unique
  /// scrypt hash in the form  scrypt$N$r$p$salt$derivedKey  — never a password.
  /// Null for Clerk-created accounts, which have no local password at all.
  passwordHash String?
  isActive     Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions AuthSession[]
  profile  UserProfile?

  @@map("user_accounts")
}

/// One row per signed-in device. Only the SHA-256 of the session token is
/// stored, so a database leak cannot be replayed as a login.
model AuthSession {
  id        String   @id @default(cuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Application profile: everything the product needs that the credential row
/// does not own.
model UserProfile {
  id           String       @id @default(cuid())
  accountId    String       @unique
  email        String?
  fullName     String
  imageUrl     String?
  college      String?
  degree       String?
  branch       String?
  academicYear String?
  rollNumber   String?
  languages    Json?
  dsaLevel     DsaLevel     @default(BEGINNER)
  careerGoals  Json?
  role         PlatformRole @default(STUDENT)

  onboardingCompleted Boolean   @default(false)
  onboardingStep      Int       @default(0)
  lastActiveAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account             UserAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  preferences         UserPreferences?
  learningProgress    LearningProgress?
  topicProgress       TopicProgress[]
  interests           UserTopicInterest[]
  submissions         Submission[]
  executions          CodeExecution[]
  attempts            QuestionAttempt[]
  hints               AIHint[]
  recommendations     AIRecommendation[]
  achievements        UserAchievement[]
  notifications       Notification[]
  authoredQuestions   Question[]           @relation("QuestionAuthor")
  aiQuestions         AIQuestion[]
  companyPreps        UserCompanyPrep[]
  universityMembers   UniversityMember[]
  createdTests        UniversityTest[]     @relation("TestCreator")
  testAssignments     UniversityTestStudent[]
  universitySubs      UniversitySubmission[]
  universityResults   UniversityResult[]

  @@index([role])
  @@index([college])
  @@map("user_profiles")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  theme              String   @default("dark")
  editorTheme        String   @default("forge-dark")
  editorFontSize     Int      @default(14)
  defaultLanguage    Language @default(CPP)
  tabSize            Int      @default(4)
  showLineNumbers    Boolean  @default(true)
  autoSaveCode       Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  streakReminders    Boolean  @default(true)
  aiHintsEnabled     Boolean  @default(true)
  dailyGoalMinutes   Int      @default(45)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Question catalog
// ---------------------------------------------------------------------------

model Topic {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  category    String?
  orderIndex  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     QuestionTopic[]
  progress      TopicProgress[]
  interests     UserTopicInterest[]
  companyTopics CompanyTopicWeight[]

  @@index([orderIndex])
  @@map("topics")
}

model UserTopicInterest {
  id      String @id @default(cuid())
  userId  String
  topicId String

  createdAt DateTime @default(now())

  user  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topic_interests")
}

model Question {
  id          String     @id @default(cuid())
  slug        String     @unique
  number      Int        @unique
  title       String
  description String    
  difficulty  Difficulty

  inputFormat  String
  outputFormat String
  constraints  String
  notes        String?

  /// [QuestionExample][] — worked examples with input, output, explanation
  examples Json?
  /// [StarterCodeMap] — language -> starter code
  starterCode Json?
  /// [SolutionMap] — language -> reference solution
  solutions Json?
  /// string[] — progressive hints (also used to seed AI hint ladder)
  hints Json?

  editorial       String? 
  approach        String? 
  intuition       String? 
  algorithmSteps  Json?
  timeComplexity  String?
  spaceComplexity String?

  supportedLanguages Json?
  /// Comma-delimited mirror of supportedLanguages, wrapped in separators
  /// (",C,CPP,") so the Practice Arena can filter by language with a plain
  /// substring match. SQLite cannot query inside a JSON column.
  languageTags       String  @default(",C,CPP,JAVA,PYTHON,")
  timeLimitMs        Int        @default(2000)
  memoryLimitMb      Int        @default(256)

  source       QuestionSource @default(CURATED)
  isPublished  Boolean        @default(true)
  authorId     String?
  acceptedCount Int           @default(0)
  attemptCount  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author          UserProfile?      @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  topics          QuestionTopic[]
  testCases       TestCase[]
  submissions     Submission[]
  executions      CodeExecution[]
  attempts        QuestionAttempt[]
  hints_given     AIHint[]
  companyLinks    CompanyQuestion[]
  recommendations AIRecommendation[]
  aiOrigin        AIQuestion?

  @@index([difficulty])
  @@index([isPublished, difficulty])
  @@index([number])
  @@map("questions")
}

model QuestionTopic {
  id         String  @id @default(cuid())
  questionId String
  topicId    String
  isPrimary  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([questionId, topicId])
  @@index([topicId])
  @@map("question_topics")
}

model TestCase {
  id         String       @id @default(cuid())
  questionId String
  kind       TestCaseKind @default(HIDDEN)
  orderIndex Int          @default(0)

  input          String 
  expectedOutput String 
  explanation    String?
  points         Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, kind])
  @@map("test_cases")
}

// ---------------------------------------------------------------------------
// Practice execution & submissions
// ---------------------------------------------------------------------------

model Submission {
  id         String @id @default(cuid())
  userId     String
  questionId String

  language Language
  code     String          
  status   SubmissionStatus @default(PENDING)

  passedTests Int @default(0)
  totalTests  Int @default(0)
  score       Int @default(0)

  runtimeMs   Int?
  memoryKb    Int?
  compileLog  String?
  errorMessage String?
  /// [TestCaseResult][] — sample-only detail; hidden case IO is never stored here
  testResults Json?

  timeComplexity  String?
  spaceComplexity String?
  aiAnalysis      String?
  aiExplanation   String?

  answerRevealed Boolean @default(false)
  hintsUsed      Int     @default(0)
  timeSpentSec   Int     @default(0)

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  execution CodeExecution?

  @@index([userId, questionId])
  @@index([userId, status])
  @@index([questionId, status])
  @@index([submittedAt])
  @@map("submissions")
}

/// One job in the sandboxed execution pipeline. Rows are created server-side
/// only; the client polls by id and never supplies results.
model CodeExecution {
  id     String @id @default(cuid())
  userId String

  questionId           String?
  universityQuestionId String?
  submissionId         String? @unique
  universitySubmissionId String? @unique

  mode     ExecutionMode   @default(RUN)
  language Language
  code     String         
  status   ExecutionStatus @default(QUEUED)

  totalTests  Int @default(0)
  passedTests Int @default(0)

  runtimeMs  Int?
  memoryKb   Int?
  exitCode   Int?
  compileLog String?
  stderr     String?
  /// [TestCaseResult][] — per-case verdicts; masked before leaving the server
  results Json?

  verdict     SubmissionStatus?
  workerId    String?
  attempts    Int      @default(0)
  queuedAt    DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question           Question?           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  universityQuestion UniversityQuestion? @relation(fields: [universityQuestionId], references: [id], onDelete: Cascade)
  submission         Submission?         @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  universitySubmission UniversitySubmission? @relation(fields: [universitySubmissionId], references: [id], onDelete: SetNull)

  @@index([status, queuedAt])
  @@index([userId, createdAt])
  @@map("code_executions")
}

/// Rolled-up per (user, question) state so the problem list does not need to
/// aggregate the whole submissions table.
model QuestionAttempt {
  id         String @id @default(cuid())
  userId     String
  questionId String

  outcome        AttemptOutcome @default(NOT_ATTEMPTED)
  attemptCount   Int            @default(0)
  acceptedCount  Int            @default(0)
  hintsUsed      Int            @default(0)
  answerRevealed Boolean        @default(false)
  bestRuntimeMs  Int?
  bestMemoryKb   Int?
  totalTimeSec   Int            @default(0)
  lastLanguage   Language?
  lastCode       String?       

  firstAttemptedAt DateTime?
  solvedAt         DateTime?
  lastAttemptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, outcome])
  @@map("question_attempts")
}

// ---------------------------------------------------------------------------
// Companies & interview prep
// ---------------------------------------------------------------------------

model Company {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  category    CompanyCategory @default(PRODUCT)
  logoEmoji   String?
  brandColor  String?
  description String?        
  hiringNotes String?        
  difficultyBias Difficulty   @default(MEDIUM)
  isActive    Boolean         @default(true)
  orderIndex  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions    CompanyQuestion[]
  topicWeights CompanyTopicWeight[]
  preps        UserCompanyPrep[]
  aiQuestions  AIQuestion[]
  recommendations AIRecommendation[]

  @@index([category, isActive])
  @@map("companies")
}

model CompanyQuestion {
  id         String @id @default(cuid())
  companyId  String
  questionId String

  /// How this association is justified — surfaced verbatim in the UI so we
  /// never imply an unverified problem was actually asked by the company.
  confidence SourceConfidence @default(COMPANY_STYLE)
  frequency  Int              @default(1)
  round      String?
  notes      String?

  createdAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([companyId, questionId])
  @@index([questionId])
  @@map("company_questions")
}

model CompanyTopicWeight {
  id        String @id @default(cuid())
  companyId String
  topicId   String
  weight    Int    @default(50)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([companyId, topicId])
  @@map("company_topic_weights")
}

model UserCompanyPrep {
  id        String @id @default(cuid())
  userId    String
  companyId String

  readinessScore Int      @default(0)
  solvedCount    Int      @default(0)
  targetCount    Int      @default(40)
  strongTopics   Json?
  weakTopics     Json?
  lastAnalyzedAt DateTime?
  isPinned       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_company_preps")
}

// ---------------------------------------------------------------------------
// AI layer
// ---------------------------------------------------------------------------

/// An AI-authored problem draft. It only becomes practice content after the
/// validation pipeline passes and (optionally) an admin publishes it.
model AIQuestion {
  id        String  @id @default(cuid())
  userId    String?
  companyId String?

  prompt     String    
  topicSlug  String?
  difficulty Difficulty @default(MEDIUM)
  model      String?
  provider   String?

  /// [GeneratedQuestionPayload] — raw structured output from the provider
  payload Json
  /// [ValidationReport] — schema/testcase/solution/difficulty gate results
  validationReport Json?

  status          AIQuestionStatus @default(DRAFT)
  failureReason   String?         
  publishedQuestionId String?      @unique
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  company          Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  publishedQuestion Question?   @relation(fields: [publishedQuestionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("ai_questions")
}

model AIRecommendation {
  id     String @id @default(cuid())
  userId String

  kind       RecommendationKind
  title      String
  body       String            
  rationale  String?           
  questionId String?
  companyId  String?
  topicSlug  String?
  difficulty Difficulty?
  priority   Int                @default(50)
  stepIndex  Int?
  isPath     Boolean            @default(false)

  dismissed   Boolean   @default(false)
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  company  Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, dismissed, priority])
  @@index([userId, isPath, stepIndex])
  @@map("ai_recommendations")
}

model AIHint {
  id         String @id @default(cuid())
  userId     String
  questionId String

  level   Int    @default(1)
  content String
  model   String?
  provider String?

  createdAt DateTime @default(now())

  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, level])
  @@index([userId, createdAt])
  @@map("ai_hints")
}

// ---------------------------------------------------------------------------
// Progress & gamification
// ---------------------------------------------------------------------------

model LearningProgress {
  id     String @id @default(cuid())
  userId String @unique

  totalSolved     Int @default(0)
  totalAttempted  Int @default(0)
  totalSubmissions Int @default(0)
  acceptedSubmissions Int @default(0)
  easySolved      Int @default(0)
  mediumSolved    Int @default(0)
  hardSolved      Int @default(0)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastSolvedOn  DateTime?

  codingSeconds  Int @default(0)
  hintsUsed      Int @default(0)
  answersRevealed Int @default(0)
  xp             Int @default(0)
  level          Int @default(1)

  /// [DailyActivity][] — heatmap buckets { date, solved, minutes }
  activity Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_progress")
}

model TopicProgress {
  id      String @id @default(cuid())
  userId  String
  topicId String

  solved       Int   @default(0)
  attempted    Int   @default(0)
  accuracy     Float @default(0)
  avgTimeSec   Int   @default(0)
  hintsUsed    Int   @default(0)
  masteryScore Int   @default(0)
  isStrong     Boolean @default(false)
  isWeak       Boolean @default(false)

  lastPracticedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, masteryScore])
  @@map("topic_progress")
}

model Achievement {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String
  category    AchievementCategory @default(MILESTONE)
  icon        String              @default("Trophy")
  tier        String              @default("bronze")
  xpReward    Int                 @default(50)
  /// [AchievementCriteria] — { metric, threshold, scope? }
  criteria    Json
  orderIndex  Int                 @default(0)
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String

  progress   Int       @default(0)
  target     Int       @default(1)
  unlockedAt DateTime?
  seen       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
  @@map("user_achievements")
}

// ---------------------------------------------------------------------------
// University assessment
// ---------------------------------------------------------------------------

model University {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  shortName String?
  city     String?
  logoUrl  String?
  /// Join code faculty share with students to request membership.
  joinCode String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   UniversityMember[]
  classes   UniversityClass[]
  tests     UniversityTest[]
  questions UniversityQuestion[]

  @@map("universities")
}

model UniversityMember {
  id           String @id @default(cuid())
  universityId String
  userId       String

  role       UniversityRole @default(STUDENT)
  department String?
  year       String?
  division   String?
  batch      String?
  rollNumber String?
  isApproved Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  university University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user       UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes    UniversityClassMember[]

  @@unique([universityId, userId])
  @@index([universityId, role])
  @@index([universityId, year, division])
  @@map("university_members")
}

model UniversityClass {
  id           String @id @default(cuid())
  universityId String

  name       String
  department String?
  year       String?
  division   String?
  batch      String?
  subject    String?
  capacity   Int     @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  university University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  members    UniversityClassMember[]
  tests      UniversityTest[]

  @@index([universityId])
  @@map("university_classes")
}

model UniversityClassMember {
  id       String @id @default(cuid())
  classId  String
  memberId String

  createdAt DateTime @default(now())

  class  UniversityClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  member UniversityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
  @@map("university_class_members")
}

/// Faculty-authored problem, kept separate from the public catalog so hidden
/// test data can never leak through public practice endpoints.
model UniversityQuestion {
  id           String @id @default(cuid())
  universityId String
  createdById  String

  title        String
  description  String    
  topic        String
  difficulty   Difficulty @default(MEDIUM)
  inputFormat  String    
  outputFormat String    
  constraints  String    
  /// [QuestionExample][]
  examples      Json?
  sampleInput   String?
  sampleOutput  String?
  /// [StarterCodeMap]
  starterCode   Json?
  /// [SolutionMap] — faculty reference solution, never sent to students
  solutions     Json?

  defaultMarks  Int @default(20)
  timeLimitMs   Int @default(2000)
  memoryLimitMb Int @default(256)

  supportedLanguages Json?
  isArchived         Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  university  University               @relation(fields: [universityId], references: [id], onDelete: Cascade)
  testCases   UniversityTestCase[]
  testLinks   UniversityTestQuestion[]
  submissions UniversitySubmission[]
  executions  CodeExecution[]

  @@index([universityId, isArchived])
  @@index([universityId, difficulty])
  @@map("university_questions")
}

model UniversityTestCase {
  id         String       @id @default(cuid())
  questionId String
  kind       TestCaseKind @default(HIDDEN)
  orderIndex Int          @default(0)

  input          String
  expectedOutput String
  points         Int    @default(1)
  explanation    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question UniversityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, kind])
  @@map("university_test_cases")
}

model UniversityTest {
  id           String  @id @default(cuid())
  universityId String
  createdById  String
  classId      String?

  name        String
  description String?
  subject     String?
  className   String?
  division    String?

  startTime DateTime
  endTime   DateTime
  /// Minutes allowed once a student starts; the server enforces this.
  durationMinutes Int  @default(60)
  capacity        Int  @default(50)
  totalMarks      Int  @default(100)
  passingMarks    Int  @default(40)

  /// Code a student enters to enrol themselves in this specific test. Distinct
  /// from University.joinCode, which only grants membership of the institution.
  /// Null on tests created before self-enrolment existed.
  joinCode        String?              @unique
  /// When false the code is refused even if it is still correct, so a host can
  /// close the doors without deleting the test.
  joinOpen        Boolean              @default(true)

  status          UniversityTestStatus @default(DRAFT)
  instructions    String?             
  allowedLanguages Json?
  partialScoring  Boolean              @default(true)
  shuffleQuestions Boolean             @default(false)
  resultsPublished Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  university   University               @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdBy    UserProfile              @relation("TestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  class        UniversityClass?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  questions    UniversityTestQuestion[]
  students     UniversityTestStudent[]
  submissions  UniversitySubmission[]
  results      UniversityResult[]
  schedules    TestSchedule[]
  similarity   CodeSimilarityReport[]

  @@index([universityId, status])
  @@index([startTime])
  @@map("university_tests")
}

model UniversityTestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String

  orderIndex Int @default(0)
  marks      Int @default(20)

  createdAt DateTime @default(now())

  test     UniversityTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question UniversityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId, orderIndex])
  @@map("university_test_questions")
}

/// Assignment + server-authoritative attempt window for one student.
model UniversityTestStudent {
  id     String @id @default(cuid())
  testId String
  userId String

  status     TestAttemptStatus @default(ASSIGNED)
  rollNumber String?
  /// Server timestamp taken when the student presses Start. The deadline is
  /// derived from this and never from the browser clock.
  startedAt  DateTime?
  deadlineAt DateTime?
  submittedAt DateTime?
  /// [MarkedForReviewMap] — questionId -> boolean
  flags Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test UniversityTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  user UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
  @@index([testId, status])
  @@map("university_test_students")
}

model UniversitySubmission {
  id         String @id @default(cuid())
  testId     String
  questionId String
  userId     String

  language Language
  code     String          
  status   SubmissionStatus @default(PENDING)

  passedTests Int @default(0)
  totalTests  Int @default(0)
  marksAwarded Float @default(0)
  maxMarks     Int   @default(0)

  runtimeMs  Int?
  memoryKb   Int?
  compileLog String?
  /// [TestCaseResult][] — full detail, faculty-only
  testResults Json?

  isFinal     Boolean  @default(false)
  autoSaved   Boolean  @default(false)
  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test      UniversityTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question  UniversityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user      UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  execution CodeExecution?

  @@index([testId, userId])
  @@index([testId, questionId])
  @@index([testId, questionId, userId, isFinal])
  @@map("university_submissions")
}

model UniversityResult {
  id     String @id @default(cuid())
  testId String
  userId String

  totalMarks      Float @default(0)
  maxMarks        Int   @default(100)
  percentage      Float @default(0)
  questionsSolved Int   @default(0)
  questionsAttempted Int @default(0)
  totalAttempts   Int   @default(0)
  passed          Boolean @default(false)
  rank            Int?
  /// [PerQuestionScore][] — { questionId, title, marks, maxMarks, passed, total }
  breakdown Json?

  timeTakenSec Int?
  submittedAt  DateTime?
  evaluatedAt  DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test UniversityTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  user UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
  @@index([testId, totalMarks])
  @@map("university_results")
}

/// Structural similarity indicator for faculty review. This is explicitly NOT
/// an accusation of misconduct — it only flags pairs worth a human look.
model CodeSimilarityReport {
  id     String @id @default(cuid())
  testId String

  questionId  String
  userAId     String
  userBId     String
  userAName   String
  userBName   String
  language    Language
  similarity  Float
  tokenSimilarity Float @default(0)
  structuralSimilarity Float @default(0)
  verdict     SimilarityVerdict @default(LOW)
  reviewed    Boolean @default(false)
  reviewNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test UniversityTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId, userAId, userBId])
  @@index([testId, similarity])
  @@map("code_similarity_reports")
}

/// Lifecycle transitions queued for a test (open/close/publish reminders).
model TestSchedule {
  id     String @id @default(cuid())
  testId String

  action      String
  runAt       DateTime
  executedAt  DateTime?
  succeeded   Boolean?
  detail      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test UniversityTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([runAt, executedAt])
  @@map("test_schedules")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String

  kind    NotificationKind @default(SYSTEM)
  title   String
  body    String          
  href    String?
  icon    String?
  read    Boolean          @default(false)
  readAt  DateTime?
  /// Arbitrary payload for rendering (ids, counts).
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}
